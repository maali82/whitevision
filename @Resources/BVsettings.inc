[Rainmeter]
; ToolTipHidden=1  to disable tooltips, =0 to enable
ToolTipHidden=0
AccurateText=1
Group=BLUEVISIONMOD

; Frosted glass blur (Win10 only — blurs entire skin window)
; https://forum.rainmeter.net/viewtopic.php?f=18&t=23106&start=20
[BlurBehind]
Measure=Plugin
Plugin=#@#Plugins/FrostedGlass.dll
BlurEnabled=0
UpdateDivider=-1

[Variables]
menutitle_copytext="Copy text to clipboard"
